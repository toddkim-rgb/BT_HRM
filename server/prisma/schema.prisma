// SM·SI 인력관리 시스템 — 명세서 13장 기준
// 날짜는 'YYYY-MM-DD' 문자열, 연월은 'YYYY-MM', 주차는 'YYYY-Www'(ISO, 월~일)
// 개발: 로컬 SQLite 파일 / 운영(Vercel): Turso (SQLite 호환, src/db.ts 어댑터)

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "rhel-openssl-3.0.x"] // rhel = Vercel 서버리스
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Employee {
  empId         String   @id // 내부 관리 번호 (자동 부여, 화면 비표시 — 사번 아님)
  name          String
  deptCd        String // 소속(본부/팀)
  gradeCd       String // 직급
  jobCd         String? // 직무
  skillLevel    String // 초급/중급/고급/특급
  skillStack    String?
  employType    String // REG/CONT/FREE/PARTNER
  partnerId     String?
  careerStartDt String?
  email         String   @unique // 로그인 ID (소문자 저장)
  phone         String?
  statusCd      String? // ACTIVE/LEAVE/RETIRED (선택 입력, 미지정은 재직으로 간주)
  deletedAt     DateTime? // 삭제 처리(보관): 목록·로그인·배정 제외, 이력 유지, 복구 가능
  deletedBy     String?
  utilTarget    Boolean  @default(true) // 가동률·투입 현황 집계 대상 (관리자·사업관리자 등은 false)
  role          String   @default("EMP") // EMP 수행인력(R-01)/PM PM·PL(R-02)/EXEC 사업관리자(R-03)/ADMIN 시스템관리자(R-04)
  passwordHash  String
  mustChangePw  Boolean  @default(false) // 초기·임시 비밀번호 → 첫 로그인 시 변경 강제
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  partner          Partner?          @relation(fields: [partnerId], references: [partnerId])
  partnerContracts PartnerContract[]
  costRates        CostRate[]
  assignments      Assignment[]
  weeklyWorks      WeeklyWork[]
  timesheets       Timesheet[]
  alerts           Alert[]
  pmProjects       Project[]         @relation("ProjectPm")
}

model Partner {
  partnerId       String   @id
  partnerNm       String
  bizRegNo        String?
  contactNm       String?
  contactPhone    String?
  contractStartDt String?
  contractEndDt   String?
  statusCd        String   @default("ACTIVE") // ACTIVE/STOPPED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  employees Employee[]
  contracts PartnerContract[]
}

model PartnerContract {
  pcId        Int      @id @default(autoincrement())
  partnerId   String
  empId       String
  prjCd       String?
  startDt     String
  endDt       String
  monthlyRate Int
  contractMm  Float?
  contractAmt Int?
  statusCd    String   @default("ACTIVE") // ACTIVE/ENDED/EXTENDED
  createdAt   DateTime @default(now())

  partner  Partner  @relation(fields: [partnerId], references: [partnerId])
  employee Employee @relation(fields: [empId], references: [empId])
}

model CostRate {
  crId         Int      @id @default(autoincrement())
  empId        String?
  gradeCd      String? // 등급별 표준 원가 (empId 없을 때)
  monthlyCost  Int
  applyStartDt String
  createdAt    DateTime @default(now())

  employee Employee? @relation(fields: [empId], references: [empId])
}

model Project {
  prjCd           String   @id // {사업구분}-{연도}-{일련번호}, 공통코드는 NP-xxx
  prjType         String // SM/SI/IN/PS/ETC/NP
  prjNm           String
  customerNm      String?
  contractType    String? // PRIME/SUB
  primeContractor String?
  startDt         String?
  endDt           String?
  contractMm      Float?
  contractAmt     Int?
  revenueMethod   String? // MONTHLY/MM
  plOpenYn        Boolean  @default(false)
  pmEmpId         String?
  residentType    String? // ONSITE/OFFSITE/MIXED
  statusCd        String   @default("ACTIVE") // PROPOSAL(제안)/ACTIVE(진행중)/DONE(완료)/STOP(중단)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  pm            Employee?        @relation("ProjectPm", fields: [pmEmpId], references: [empId])
  assignments   Assignment[]
  billRates     BillRate[]
  demandPlans   DemandPlan[]
  expenses      ProjectExpense[]
  timesheets    Timesheet[]
  workItems     WorkItem[]
  issues        WeeklyIssue[]
  milestones    Milestone[]
  weeklyComment WeeklyComment[]
}

model BillRate {
  brId         Int      @id @default(autoincrement())
  prjCd        String
  roleCd       String
  gradeCd      String
  monthlyRate  Int
  applyStartDt String
  createdAt    DateTime @default(now())

  project Project @relation(fields: [prjCd], references: [prjCd])
}

model Assignment {
  asgId        Int      @id @default(autoincrement())
  empId        String
  prjCd        String
  roleCd       String // PM/PL/DESIGN/DEV/OPS ...
  startDt      String
  endDt        String
  allocRate    Int // 0~100
  residentType String   @default("ONSITE")
  canceled     Boolean  @default(false) // 진행 상태는 날짜로 계산
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee Employee @relation(fields: [empId], references: [empId])
  project  Project  @relation(fields: [prjCd], references: [prjCd])
}

model DemandPlan {
  dpId      Int      @id @default(autoincrement())
  prjCd     String
  roleCd    String
  gradeCd   String
  headcount Int
  startYm   String
  endYm     String
  allocRate Int      @default(100)
  createdBy String?
  createdAt DateTime @default(now())

  project Project @relation(fields: [prjCd], references: [prjCd])
}

model WeeklyWork {
  wwId         Int       @id @default(autoincrement())
  empId        String
  reportWeek   String
  statusCd     String    @default("DRAFT") // DRAFT/SUBMITTED (승인 절차 없음, 제출 = 확정)
  remark       String?
  submittedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  employee   Employee      @relation(fields: [empId], references: [empId])
  timesheets Timesheet[]
  workItems  WorkItem[]
  issues     WeeklyIssue[]

  @@unique([empId, reportWeek])
}

model Timesheet {
  tsId   Int    @id @default(autoincrement())
  wwId   Int
  empId  String
  prjCd  String
  workDt String
  md     Float

  weeklyWork WeeklyWork @relation(fields: [wwId], references: [wwId], onDelete: Cascade)
  employee   Employee   @relation(fields: [empId], references: [empId])
  project    Project    @relation(fields: [prjCd], references: [prjCd])

  @@unique([empId, prjCd, workDt])
}

model WorkItem {
  wiId           Int     @id @default(autoincrement())
  wwId           Int
  prjCd          String
  msId           Int?
  itemType       String // ACTUAL/PLAN
  seq            Int     @default(0)
  workNm         String
  content        String?
  progressBefore Int?
  progressAfter  Int?
  targetProgress Int?
  dueDt          String?
  statusCd       String? // NORMAL/DELAY/DONE
  delayReason    String?
  smWorkType     String? // PERIODIC/REQUEST/INCIDENT/IMPROVE/ETC
  smCount        Int?

  weeklyWork WeeklyWork @relation(fields: [wwId], references: [wwId], onDelete: Cascade)
  project    Project    @relation(fields: [prjCd], references: [prjCd])
  milestone  Milestone? @relation(fields: [msId], references: [msId])
}

model WeeklyIssue {
  wisId        Int     @id @default(autoincrement())
  wwId         Int
  prjCd        String
  issueType    String // ISSUE/RISK/REQUEST
  severity     String // H/M/L
  content      String
  actionPlan   String?
  supportReqYn Boolean @default(false)
  onepageYn    Boolean @default(false)

  weeklyWork WeeklyWork @relation(fields: [wwId], references: [wwId], onDelete: Cascade)
  project    Project    @relation(fields: [prjCd], references: [prjCd])
}

// 주요 마일스톤 (v1.0 단순화): PM이 이름·계획일을 등록하고 완료일을 체크
// 상태는 날짜로 계산: 완료(doneDt 있음) / 지연(계획일 경과·미완료) / 예정
model Milestone {
  msId   Int     @id @default(autoincrement())
  prjCd  String
  seq    Int     @default(0)
  msNm   String
  planDt String
  doneDt String?
  note   String?

  project   Project    @relation(fields: [prjCd], references: [prjCd])
  workItems WorkItem[]
}

model ProjectExpense {
  exId        Int      @id @default(autoincrement())
  prjCd       String
  expenseYm   String
  amount      Int
  expenseType String
  memo        String?
  createdAt   DateTime @default(now())

  project Project @relation(fields: [prjCd], references: [prjCd])
}

model Alert {
  alertId     Int      @id @default(autoincrement())
  alertCd     String // AL-01 ~ AL-06
  targetEmpId String
  refKey      String
  message     String
  readYn      Boolean  @default(false)
  createdAt   DateTime @default(now())

  target Employee @relation(fields: [targetEmpId], references: [empId])

  @@unique([alertCd, targetEmpId, refKey])
}

// 전사 주간 One-Page: 확정 전에는 조회할 때마다 최신 데이터로 계산, 확정 시 snapshot 고정
model WeeklyReport {
  reportWeek  String    @id
  snapshot    String? // JSON (확정 시점 집계)
  statusCd    String    @default("DRAFT") // DRAFT/CONFIRMED
  execNote    String? // ⑤ 주요 이슈·리스크 종합 (사업부장 편집)
  nextPlan    String? // ⑥ 차주 계획 / 의사결정 필요 사항
  confirmedBy String?
  confirmedAt DateTime?
  updatedAt   DateTime  @updatedAt
}

// 프로젝트 주간보고: 자동 취합 + PM 종합 의견. 확정 시 snapshot 고정
// report_week는 주차 값일 뿐 WeeklyReport FK 아님
model WeeklyComment {
  wcId        Int       @id @default(autoincrement())
  reportWeek  String
  prjCd       String
  pmOpinion   String?
  confirmedYn Boolean   @default(false)
  confirmedBy String?
  confirmedAt DateTime?
  snapshot    String? // JSON
  updatedAt   DateTime  @updatedAt

  project Project @relation(fields: [prjCd], references: [prjCd])

  @@unique([reportWeek, prjCd])
}

model Holiday {
  dt   String @id
  name String
}

model Setting {
  key   String @id
  value String
}

// 로그인 화면의 비밀번호 재설정 요청·ID 문의 → 관리자가 처리 (메일 발송 없음)
model AccountRequest {
  reqId        Int       @id @default(autoincrement())
  reqType      String // PW_RESET / ID_INQUIRY
  name         String
  email        String?
  contact      String?
  message      String?
  matchedEmpId String? // 입력값과 일치하는 인력 (관리자 확인용)
  statusCd     String    @default("OPEN") // OPEN / DONE / REJECTED
  handledBy    String?
  handledAt    DateTime?
  handleNote   String?
  createdAt    DateTime  @default(now())
}

// 메뉴별 접근 권한 (역할 × 메뉴 → NONE/VIEW/EDIT), 관리자 '메뉴 권한' 화면에서 변경
model MenuPermission {
  role  String
  menu  String
  level String @default("NONE")

  @@id([role, menu])
}
